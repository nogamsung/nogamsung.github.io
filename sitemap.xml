---
layout: null
permalink: /sitemap.xml
---
{%- comment -%}
jekyll-sitemap 기본 템플릿을 대체한다. 글/홈/소개만 포함하고
noindex 처리된 태그·카테고리·아카이브 목록과 네이버 인증 파일은 제외한다.
{%- endcomment -%}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% for post in site.posts %}
    {% unless post.sitemap == false %}
  <url>
    <loc>{{ post.url | absolute_url | xml_escape }}</loc>
    {% if post.last_modified_at %}
    <lastmod>{{ post.last_modified_at | date_to_xmlschema }}</lastmod>
    {% else %}
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
    {% endunless %}
  {% endfor %}
  {% assign skip_layouts = "tag,category,tags,categories,archives" | split: "," %}
  {% for page in site.pages %}
    {% assign ext = page.url | split: "." | last %}
    {% assign name_ext = page.name | split: "." | last %}
    {% unless name_ext == 'html' or name_ext == 'md' or name_ext == 'markdown' %}{% continue %}{% endunless %}
    {% if page.sitemap == false or page.url contains '/page' or page.url == '/404.html' or page.url == '/redirects.json' or page.url == '/feed.xml' or page.url == '/rss.xml' or page.url == '/sitemap.xml' or page.url == '/robots.txt' or page.url contains '/assets/' or page.url contains 'naver' %}{% continue %}{% endif %}
    {% if skip_layouts contains page.layout %}{% continue %}{% endif %}
    {% if ext == 'xml' or ext == 'json' or ext == 'js' or ext == 'css' or ext == 'txt' %}{% continue %}{% endif %}
  <url>
    <loc>{{ page.url | absolute_url | xml_escape }}</loc>
    {% if page.last_modified_at %}
    <lastmod>{{ page.last_modified_at | date_to_xmlschema }}</lastmod>
    {% endif %}
  </url>
  {% endfor %}
  {% for tab in site.tabs %}
    {% if skip_layouts contains tab.layout or tab.sitemap == false %}{% continue %}{% endif %}
  <url>
    <loc>{{ tab.url | absolute_url | xml_escape }}</loc>
  </url>
  {% endfor %}
</urlset>
